# DnD Spending Tracker - Configuration

# Server Configuration
PORT=3000

# Open Banking API Configuration (Example - not real credentials)
# Uncomment and configure based on your chosen open banking provider

# Example: Plaid
# PLAID_CLIENT_ID=your_client_id
# PLAID_SECRET=your_secret
# PLAID_ENV=sandbox

# Example: TrueLayer
# TRUELAYER_CLIENT_ID=your_client_id
# TRUELAYER_CLIENT_SECRET=your_client_secret

# Example: Yodlee
# YODLEE_CLIENT_ID=your_client_id
# YODLEE_CLIENT_SECRET=your_client_secret

# Database Configuration (if needed)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=dndspending
# DB_USER=postgres
# DB_PASSWORD=your_password
